{
  // One Cloudflare Worker serves the static site (and, later, the /api routes).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "programmersbible",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  // The site's own domain. Cloudflare creates the DNS records and the HTTPS certificate on deploy;
  // the domain's DNS must be managed by Cloudflare (its nameservers point to Cloudflare).
  "routes": [
    { "pattern": "programmersbible.com", "custom_domain": true },
    { "pattern": "www.programmersbible.com", "custom_domain": true }
  ]
}
