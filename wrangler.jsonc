{
  // One Cloudflare Worker serves the static site and the /api routes (api/index.ts).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "programmersbible",
  "main": "api/index.ts",
  "compatibility_date": "2026-10-30",
  // Better Auth uses AsyncLocalStorage (node:async_hooks).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Only /api/* runs the Worker; every page and file is still served directly, so reading never
    // depends on the Worker or the database.
    "run_worker_first": ["/api/*"]
  },
  // Accounts and reading progress. Created with `npx wrangler d1 create programmersbible`.
  // Migrations (db/migrations, written by `npx drizzle-kit generate`) are applied with
  // `npx wrangler d1 migrations apply programmersbible --local` (or --remote). See SETUP-ACCOUNTS.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "programmersbible",
      "database_id": "f9ce52d8-41ac-4f4f-a201-0671a0070b37",
      "migrations_dir": "db/migrations"
    }
  ],
  // Secrets (set with `npx wrangler secret put <NAME>`; locally in .dev.vars, see .dev.vars.example):
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, BETTER_AUTH_SECRET, BETTER_AUTH_URL.
  // The site's own domain. Cloudflare creates the DNS records and the HTTPS certificate on deploy;
  // the domain's DNS must be managed by Cloudflare (its nameservers point to Cloudflare).
  "routes": [
    { "pattern": "programmersbible.com", "custom_domain": true },
    { "pattern": "www.programmersbible.com", "custom_domain": true }
  ]
}
