{
  "name": "programmersbible",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && astro build",
    "build:preview": "npm run validate && SHOW_DRAFTS=true astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "validate": "tsx scripts/build-graph.ts --check",
    "build:graph": "tsx scripts/build-graph.ts",
    "status": "tsx scripts/node-status.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "astro": "^7.4.4",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  }
}
