{
  "name": "programmersbible",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/copy-images.ts && astro dev",
    "build": "npm run validate && npm run build:site",
    "build:site": "tsx scripts/copy-images.ts && astro build && pagefind --site dist",
    "build:preview": "npm run validate && SHOW_DRAFTS=true npm run build:site",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "validate": "tsx scripts/build-graph.ts --check",
    "build:graph": "tsx scripts/build-graph.ts",
    "status": "tsx scripts/node-status.ts",
    "typecheck": "tsc --noEmit",
    "fetch-image": "tsx scripts/fetch-image.ts",
    "shoot": "tsx scripts/shoot.ts",
    "optimize-images": "tsx scripts/optimize-images.ts",
    "share-image": "tsx scripts/share-image.ts",
    "a11y": "tsx scripts/a11y.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.4",
    "cytoscape": "^3.34.4",
    "cytoscape-fcose": "^2.2.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.4",
    "marked": "^18.1.2",
    "mermaid-isomorphic": "^3.1.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^26.6.6",
    "pagefind": "^1.5.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  }
}
