---
import cytoscape from "cytoscape";
import fcose from "cytoscape-fcose";
import Base from "../layouts/Base.astro";
import { allPaths, isReadable, nodes, nodeUrl } from "../lib/content.ts";

cytoscape.use(fcose);

// How many topics build on this one, directly or indirectly. Foundational topics
// get bigger dots and their names appear first when you zoom in.
const dependents = new Map<string, string[]>(nodes.map((n) => [n.id, []]));
for (const n of nodes) for (const r of n.requires) dependents.get(r)?.push(n.id);
function reach(id: string, seen = new Set<string>()): Set<string> {
  for (const d of dependents.get(id) ?? []) if (!seen.has(d)) reach(d, seen.add(d));
  return seen;
}

// One box per First Chapter part, titled by its path section ("Part 1: The Machine"), and one box
// per other path ("More to Explore"), so the topics read after the First Chapter sit together.
const firstChapter = allPaths.find((p) => p.id === "first-chapter");
const inFirstChapter = new Set(firstChapter?.sections.flatMap((s) => s.nodes) ?? []);
const otherPath = new Map(
  allPaths.filter((p) => p !== firstChapter).flatMap((p) => p.sections.flatMap((s) => s.nodes.map((id) => [id, p] as const))),
);
const groupOf = (n: (typeof nodes)[number]) =>
  inFirstChapter.has(n.id) ? n.part : (otherPath.get(n.id)?.id ?? n.part);
const partTitles: Record<string, string> = {};
for (const section of firstChapter?.sections ?? []) {
  const first = nodes.find((n) => n.id === section.nodes[0]);
  if (first) partTitles[first.part] ??= section.title;
}
for (const n of nodes) {
  const path = otherPath.get(n.id);
  if (!inFirstChapter.has(n.id) && path) partTitles[path.id] ??= path.title;
}

const weights = new Map(nodes.map((n) => [n.id, reach(n.id).size]));
const maxWeight = Math.max(...weights.values(), 1);
const size = (id: string) => Math.round(16 + 40 * Math.sqrt(weights.get(id)! / maxWeight));
const edges = nodes.flatMap((n) => n.requires.map((r) => ({ from: r, to: n.id })));

// A small seeded random number generator, so the layout is the same on every build.
function seeded(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
// An arrow that passes through (or right next to) another topic's dot looks as if it starts or ends
// there, and lies on top of that topic's own arrows. Find such dots: for each, the arrow, how far
// along it the dot is (t, 0 to 1), its signed distance from the line and the room it needs.
const CLEARANCE = 14;
function crowdedDots(graph: cytoscape.Core) {
  const found: { edge: cytoscape.EdgeSingular; t: number; offset: number; need: number }[] = [];
  for (const e of graph.edges()) {
    const a = e.source().position();
    const b = e.target().position();
    const dx = b.x - a.x;
    const dy = b.y - a.y;
    const length2 = dx * dx + dy * dy;
    for (const dot of graph.nodes(":childless")) {
      if (dot.same(e.source()) || dot.same(e.target())) continue;
      const p = dot.position();
      const t = ((p.x - a.x) * dx + (p.y - a.y) * dy) / length2; // where along the arrow, 0 to 1
      if (t <= 0 || t >= 1) continue;
      // Positive offset: the dot is on the left of the arrow, seen from its start.
      const offset = ((p.y - a.y) * dx - (p.x - a.x) * dy) / Math.sqrt(length2);
      const need = dot.data("size") / 2 + CLEARANCE;
      if (Math.abs(offset) < need) found.push({ edge: e, t, offset, need });
    }
  }
  return found;
}

// Lay the map out at build time with fixed seeds, so it looks the same on every visit and readers
// can learn where things are. Try several seeds and keep the layout with the fewest crowded dots.
function runLayout(seed: number) {
  const random = Math.random;
  Math.random = seeded(seed);
  const graph = cytoscape({
    headless: true,
    styleEnabled: true,
    style: [{ selector: "node", style: { width: "data(size)", height: "data(size)" } }],
    elements: [
      ...Object.keys(partTitles).map((id) => ({ data: { id: `part-${id}` } })),
      ...nodes.map((n) => ({ data: { id: n.id, parent: `part-${groupOf(n)}`, size: size(n.id) } })),
      ...edges.map((e) => ({ data: { source: e.from, target: e.to } })),
    ],
  });
  graph
    .layout({
      name: "fcose",
      quality: "proof",
      animate: false,
      nodeSeparation: 160,
      idealEdgeLength: 140,
      nodeRepulsion: 30000,
      nestingFactor: 0.6,
      gravityCompound: 1.2,
    } as cytoscape.LayoutOptions)
    .run();
  Math.random = random;
  return graph;
}
let layout = runLayout(1);
for (let seed = 2; seed <= 20; seed++) {
  const candidate = runLayout(seed);
  if (crowdedDots(candidate).length < crowdedDots(layout).length) layout = candidate;
}
// The layout can let part boxes overlap. Push them apart, moving every topic in a part together.
const PART_GAP = 80;
const partIds = Object.keys(partTitles).map((id) => `part-${id}`);
for (let round = 0; round < 50; round++) {
  let moved = false;
  for (const [i, a] of partIds.entries()) {
    for (const b of partIds.slice(i + 1)) {
      const A = layout.getElementById(a).boundingBox();
      const B = layout.getElementById(b).boundingBox();
      const overlapX = Math.min(A.x2, B.x2) - Math.max(A.x1, B.x1) + PART_GAP;
      const overlapY = Math.min(A.y2, B.y2) - Math.max(A.y1, B.y1) + PART_GAP;
      if (overlapX <= 0 || overlapY <= 0) continue;
      // Move B the shorter way out, away from A.
      const shift =
        overlapX < overlapY
          ? { x: (B.x1 + B.x2 > A.x1 + A.x2 ? 1 : -1) * overlapX, y: 0 }
          : { x: 0, y: (B.y1 + B.y2 > A.y1 + A.y2 ? 1 : -1) * overlapY };
      layout.getElementById(b).children().shift(shift);
      moved = true;
    }
  }
  if (!moved) break;
}

// The arrows that would still pass through a dot bend around it, like a road around a building.
// A bend is a list of control points: how far along the arrow (weight, 0 to 1) and how far to the
// side (distance; positive is the same side as a positive offset above).
type Bend = { weights: number[]; distances: number[] };

// Points along the curve as the browser draws it: one quadratic curve per control point, joined
// halfway between control points.
function curvePoints(edge: cytoscape.EdgeSingular, bend: Bend) {
  const a = edge.source().position();
  const b = edge.target().position();
  const [dx, dy] = [b.x - a.x, b.y - a.y];
  const length = Math.hypot(dx, dy);
  const [nx, ny] = [-dy / length, dx / length];
  const controls = bend.weights.map((w, i) => ({
    x: a.x + w * dx + bend.distances[i]! * nx,
    y: a.y + w * dy + bend.distances[i]! * ny,
  }));
  const mid = (p: { x: number; y: number }, q: { x: number; y: number }) => ({ x: (p.x + q.x) / 2, y: (p.y + q.y) / 2 });
  const ends = [a, ...controls.slice(0, -1).map((c, i) => mid(c, controls[i + 1]!)), b];
  const points: { x: number; y: number }[] = [];
  controls.forEach((c, i) => {
    const [p, q] = [ends[i]!, ends[i + 1]!];
    for (let k = 0; k <= 40; k++) {
      const u = k / 40;
      points.push({ x: (1 - u) ** 2 * p.x + 2 * u * (1 - u) * c.x + u * u * q.x, y: (1 - u) ** 2 * p.y + 2 * u * (1 - u) * c.y + u * u * q.y });
    }
  });
  return points;
}
const touchesADot = (edge: cytoscape.EdgeSingular, bend: Bend) =>
  curvePoints(edge, bend).some((q) =>
    layout.nodes(":childless").some((dot) => {
      if (dot.same(edge.source()) || dot.same(edge.target())) return false;
      const p = dot.position();
      return Math.hypot(q.x - p.x, q.y - p.y) < dot.data("size") / 2 + CLEARANCE / 2;
    }),
  );

const crowded = new Map<cytoscape.EdgeSingular, ReturnType<typeof crowdedDots>>();
for (const c of crowdedDots(layout)) crowded.set(c.edge, [...(crowded.get(c.edge) ?? []), c]);
const bends = new Map<string, Bend>();
for (const [edge, dots] of crowded) {
  dots.sort((p, q) => p.t - q.t);
  // Pass each dot on the side away from its center. A curve reaches about half its control
  // distance, so aim for twice the needed offset. If that still touches a dot, try the other
  // side and wider bends, and keep the first one that is clear.
  const tries: Bend[] = [];
  for (const flip of [1, -1])
    for (const widen of [1, 1.5, 2.2])
      tries.push({
        weights: dots.map((d) => Math.round(d.t * 100) / 100),
        distances: dots.map((d) => {
          const side = (d.offset >= 0 ? -1 : 1) * flip;
          return Math.round((d.offset + side * d.need) * 2 * widen);
        }),
      });
  const best = tries.find((bend) => !touchesADot(edge, bend)) ?? tries[0]!;
  bends.set(`${edge.source().id()}->${edge.target().id()}`, best);
}
const stillTouching = [...crowded.keys()].filter((e) => touchesADot(e, bends.get(`${e.source().id()}->${e.target().id()}`)!));
console.log(`[map] ${bends.size} of ${edges.length} arrows bend around a dot; ${stillTouching.length} still touch one`);

const data = {
  parts: Object.entries(partTitles).map(([id, title]) => ({ id, title })),
  nodes: nodes.map((n) => ({
    id: n.id,
    title: n.title,
    type: n.type,
    part: groupOf(n),
    status: n.status,
    readable: isReadable(n),
    summary: isReadable(n) ? (n.summary ?? "") : "",
    year: n.year ?? null,
    weight: weights.get(n.id)!,
    size: size(n.id),
    position: layout.getElementById(n.id).position(),
    url: nodeUrl(n.id),
  })),
  edges: edges.map((e) => ({ ...e, bend: bends.get(`${e.from}->${e.to}`) ?? null })),
};
---

<Base title="Map" description="Every topic and how they connect. Zoom in to see more.">
  <h1 class="visually-hidden">Map</h1>
  <p class="muted">
    Every topic, and what you need to know first. Zoom out to see the big parts; zoom in to see each topic and
    what it is about. Tap a topic to see what to learn before it. Prefer a list? Follow the <a href="/path/first-chapter">First Chapter</a>.
  </p>

  <ul class="map-legend small muted">
    <li><span class="dot concept"></span> Topic</li>
    <li><span class="dot event"></span> History</li>
    <li><span class="dot project"></span> Project</li>
    <li><span class="dot unread"></span> Being written</li>
    <li><span class="dot planned"></span> Not written yet</li>
    <li>Bigger dot: more topics build on it. Arrows point from what you learn first to what it unlocks.</li>
  </ul>

  <div class="map-wrap">
    <div id="map" aria-label="Map of all topics. The same topics are listed in the First Chapter."></div>
    <div id="map-labels" aria-hidden="true"></div>
    <div class="map-controls">
      <button type="button" data-zoom="in" aria-label="Zoom in">+</button>
      <button type="button" data-zoom="out" aria-label="Zoom out">−</button>
      <button type="button" data-zoom="fit" aria-label="Show everything">⤢</button>
    </div>
    <aside id="map-panel" hidden>
      <button type="button" class="close" aria-label="Close">×</button>
      <div class="small muted" id="panel-kind"></div>
      <h2 id="panel-title"></h2>
      <p id="panel-summary"></p>
      <p class="small"><span class="key-line before"></span><span id="panel-requires"></span></p>
      <p class="small" id="panel-leads-row"><span class="key-line after"></span><span id="panel-leads"></span></p>
      <a class="button" id="panel-read" href="#">Read</a>
    </aside>
  </div>

  <script is:inline type="application/json" id="map-data" set:html={JSON.stringify(data)} />
</Base>

<style>
  .map-wrap {
    position: relative;
    height: 75vh;
    min-height: 28rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
    overflow: hidden;
  }
  #map { position: absolute; inset: 0; }
  /* Names are page text on a layer above the map, like street-map labels: sharp and the same size at any zoom. */
  #map-labels { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  #map-labels :global(.map-label) {
    position: absolute;
    left: 0;
    top: 0;
    width: max-content;
    max-width: 9rem;
    padding: 0 0.2rem;
    border-radius: 3px;
    background: color-mix(in srgb, var(--card) 85%, transparent);
    color: var(--fg);
    font-size: 0.75rem;
    line-height: 1.25;
    text-align: center;
    transition: opacity 0.25s;
  }
  #map-labels :global(.map-label.key) { font-size: 0.875rem; }
  #map-labels :global(.map-label .sum) { display: none; margin-top: 0.15rem; color: var(--muted); font-size: 0.72rem; }
  #map-labels:global(.detail) :global(.map-label) { max-width: 12rem; }
  #map-labels:global(.detail) :global(.map-label .sum) { display: block; }
  #map-labels :global(.map-label.faded) { opacity: 0.15; }
  #map-labels :global(.map-label.off) { opacity: 0; }
  #map-labels :global(.part-label) {
    position: absolute;
    left: 0;
    top: 0;
    color: var(--muted);
    font-size: 1rem;
    font-weight: 700;
    white-space: nowrap;
    transition: font-size 0.2s, color 0.2s;
  }
  #map-labels:global(.far) :global(.part-label) { color: var(--part); font-size: 1.4rem; }
  @media (max-width: 640px) {
    #map-labels:global(.far) :global(.part-label) { font-size: 1.1rem; }
  }
  .map-controls {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .map-controls button,
  #map-panel .close {
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    color: var(--fg);
    font-size: 1.1rem;
    cursor: pointer;
  }
  #map-panel {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: min(22rem, calc(100% - 4.5rem));
    max-height: calc(100% - 1.5rem);
    overflow: auto;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg);
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.15);
  }
  #map-panel h2 { margin: 0.2rem 2rem 0.5rem 0; font-size: 1.25rem; line-height: 1.3; }
  #map-panel .close { position: absolute; top: 0.5rem; right: 0.5rem; width: 1.9rem; height: 1.9rem; }
  #map-panel [hidden] { display: none; }
  /* Same colors as the arrows on the map. */
  .key-line { display: inline-block; width: 1rem; height: 3px; margin-right: 0.4rem; border-radius: 2px; vertical-align: 0.2rem; }
  .key-line.before { background: var(--event); }
  .key-line.after { background: var(--accent); }
  .map-legend { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin: 0 0 0.75rem; padding: 0; list-style: none; }
  .dot { display: inline-block; width: 0.8rem; height: 0.8rem; border-radius: 50%; background: var(--accent); vertical-align: -0.05rem; }
  .dot.event { background: var(--event); transform: rotate(45deg); border-radius: 2px; }
  .dot.project { background: var(--ok); border-radius: 2px; }
  .dot.unread { background: var(--accent-soft); border: 2px solid var(--accent); }
  .dot.planned { background: transparent; border: 2px dashed var(--muted); }
</style>


<script>
  import cytoscape from "cytoscape";

  type MapNode = {
    id: string; title: string; type: string; part: string; status: string; readable: boolean;
    summary: string; year: number | null; weight: number; size: number; position: { x: number; y: number }; url: string;
  };
  type MapData = {
    parts: { id: string; title: string }[];
    nodes: MapNode[];
    edges: { from: string; to: string; bend: { weights: number[]; distances: number[] } | null }[];
  };

  const data: MapData = JSON.parse(document.getElementById("map-data")!.textContent!);
  const css = getComputedStyle(document.documentElement);
  const v = (name: string) => css.getPropertyValue(name).trim();
  const dark = matchMedia("(prefers-color-scheme: dark)").matches;
  const partColor: Record<string, string> = dark
    ? { machine: "#8fb0ff", network: "#5fd0c4", web: "#d3a6ff", code: "#f0b45c", "more-to-explore": "#f0b45c" }
    : { machine: "#2b59c3", network: "#0f7f7a", web: "#7b45c4", code: "#9a5b00", "more-to-explore": "#9a5b00" };

  // Zoom levels, as a multiple of the "show everything" zoom. Like towns on a street map, topics
  // appear one by one as you zoom in: each part's key topics always, the rest from 0.9× to 2.4×.
  const KEY_TOPICS = 3; // per part, shown at every zoom so no part is ever empty
  const FIRST = 0.9;
  const ALL = 2.4;
  const PARTS_ONLY = 1.3; // below this: part names stand out
  const DETAIL = 3.4; // from this: each topic shows its summary
  // Ranked inside each part, so every part shows its own key topics first.
  const rank = new Map<string, number>();
  for (const p of data.parts) {
    const inPart = data.nodes.filter((n) => n.part === p.id).sort((a, b) => b.weight - a.weight);
    inPart.forEach((n, i) =>
      rank.set(n.id, i < KEY_TOPICS ? -1 : (i - KEY_TOPICS) / Math.max(inPart.length - KEY_TOPICS - 1, 1)),
    );
  }

  const cy = cytoscape({
    container: document.getElementById("map"),
    // Topics stay where the layout put them: dragging anywhere moves the view.
    autoungrabify: true,
    autounselectify: true,
    elements: [
      ...data.parts.map((p) => ({ data: { id: `part-${p.id}`, color: partColor[p.id] ?? v("--accent") }, classes: "part" })),
      ...data.nodes.map((n) => ({
        position: n.position,
        data: { ...n, parent: `part-${n.part}`, color: partColor[n.part] ?? v("--accent") },
        classes: [n.type, n.status, n.readable ? "readable" : "unread"].join(" "),
      })),
      ...data.edges.map((e) => ({ data: { id: `${e.from}->${e.to}`, source: e.from, target: e.to } })),
    ],
    style: [
      {
        selector: "node",
        style: {
          width: "data(size)",
          height: "data(size)",
          "background-color": "data(color)",
          "transition-property": "opacity",
          "transition-duration": 250,
        },
      },
      { selector: "node.event", style: { shape: "diamond" } },
      { selector: "node.project", style: { shape: "star", "background-color": v("--ok") } },
      // Solid: ready to read. Light: being written. Dashed: not written yet.
      { selector: "node.unread", style: { "background-opacity": 0.2, "border-width": 2, "border-color": "data(color)" } },
      { selector: "node.planned", style: { "border-style": "dashed" } },
      {
        selector: "node.part",
        style: {
          shape: "round-rectangle",
          "background-color": "data(color)",
          "background-opacity": 0.05,
          "border-width": 1,
          "border-color": v("--line"),
          padding: "24px",
          // The part boxes ignore the mouse, so dragging on them moves the view too.
          events: "no",
        },
      },
      {
        selector: "edge",
        style: {
          width: 1.2,
          "line-color": v("--muted"),
          "target-arrow-color": v("--muted"),
          "target-arrow-shape": "triangle",
          "arrow-scale": 0.7,
          "curve-style": "bezier",
          opacity: 0.35,
          "transition-property": "opacity",
          "transition-duration": 250,
        },
      },
      // A tapped topic, everything it needs and everything it unlocks.
      { selector: ".faded", style: { opacity: 0.12 } },
      // Arrows into the tapped topic (learn first) and out of it (unlocks) get their own colors.
      { selector: "edge.lit", style: { opacity: 1, width: 2.5, "arrow-scale": 1 } },
      { selector: "edge.before", style: { "line-color": v("--event"), "target-arrow-color": v("--event") } },
      { selector: "edge.after", style: { "line-color": v("--accent"), "target-arrow-color": v("--accent") } },
      { selector: "node.focus", style: { "border-width": 3, "border-style": "solid", "border-color": v("--fg") } },
      // Topics not shown at this zoom fade away and are not drawn, unless they are part of a tapped topic's route.
      { selector: ".lod-hidden", style: { opacity: 0, events: "no" } },
      { selector: ".lod-hidden.lit", style: { opacity: 1, events: "yes" } },
    ],
    layout: { name: "preset" },
  });

  // Arrows that would pass through another topic's dot bend around it (worked out at build time).
  for (const e of data.edges) {
    if (!e.bend) continue;
    cy.getElementById(`${e.from}->${e.to}`).style({
      "curve-style": "unbundled-bezier",
      "control-point-weights": e.bend.weights,
      "control-point-distances": e.bend.distances,
    });
  }

  const root = cy.container()!;
  const topics = cy.nodes(":childless");
  let fitZoom = 1;

  function fitAll() {
    cy.fit(undefined, 40);
    fitZoom = cy.zoom();
    cy.minZoom(fitZoom * 0.85); // zooming out further only makes everything smaller
    cy.maxZoom(fitZoom * 12);
    topics.forEach((n) => {
      const r = rank.get(n.id())!;
      n.data("appearAt", r < 0 ? 0 : FIRST + (ALL - FIRST) * r);
    });
  }

  // ---- Names: page text on a layer above the map ----
  const layer = document.getElementById("map-labels")!;
  type Label = { node: cytoscape.NodeSingular; el: HTMLDivElement; w: number; h: number };
  const labels: Label[] = topics
    .sort((a, b) => rank.get(a.id())! - rank.get(b.id())!) // most important first
    .map((node) => {
      const d = node.data() as MapNode;
      const el = document.createElement("div");
      el.className = rank.get(d.id)! < 0 ? "map-label key" : "map-label";
      el.textContent = d.title;
      const sum = document.createElement("div");
      sum.className = "sum";
      sum.textContent = d.summary || (d.status === "planned" ? "Not written yet" : "Being written");
      el.append(sum);
      layer.append(el);
      return { node, el, w: 0, h: 0 };
    });
  const partLabels = cy.nodes(".part").map((part) => {
    const el = document.createElement("div");
    el.className = "part-label";
    el.textContent = data.parts.find((p) => `part-${p.id}` === part.id())!.title;
    el.style.setProperty("--part", part.data("color"));
    layer.append(el);
    return { part, el };
  });

  // Label sizes change only when summaries are shown or hidden, so measure them then.
  function measureLabels() {
    for (const l of labels) {
      l.w = l.el.offsetWidth;
      l.h = l.el.offsetHeight;
    }
  }

  // Every frame: put each name next to its dot, where it does not cover another name. When there is no
  // free spot, the more important name (or one on a tapped topic's route) wins and the other waits for more room.
  function placeLabels() {
    const placed: { x1: number; y1: number; x2: number; y2: number }[] = [];
    const width = root.clientWidth;
    const height = root.clientHeight;
    const isFree = (box: (typeof placed)[number]) =>
      !placed.some((b) => box.x1 < b.x2 && b.x1 < box.x2 && box.y1 < b.y2 && b.y1 < box.y2);
    // Part titles go first: above their box, or else inside its top or below it, and never past the
    // map's left or right edge (small screens). Topic names then keep clear of them.
    for (const { part, el } of partLabels) {
      const b = part.renderedBoundingBox();
      const [w, h] = [el.offsetWidth, el.offsetHeight];
      const x1 = Math.max(0, Math.min(width - w, (b.x1 + b.x2) / 2 - w / 2));
      const spots = [b.y1 - 4 - h, b.y1 + 4, b.y2 + 4].map((y) => ({ x1, y1: y, x2: x1 + w, y2: y + h }));
      const box = spots.find(isFree) ?? spots[0]!;
      el.style.transform = `translate(${Math.round(box.x1)}px, ${Math.round(box.y1)}px)`;
      placed.push(box);
    }
    const lit = labels.filter((l) => l.node.hasClass("lit"));
    const order = lit.length ? [...lit, ...labels.filter((l) => !l.node.hasClass("lit"))] : labels;
    for (const l of order) {
      const p = l.node.renderedPosition();
      const r = l.node.renderedHeight() / 2 + 2;
      // Try below the dot first, then above, right and left.
      const spots = [
        { x: p.x - l.w / 2, y: p.y + r },
        { x: p.x - l.w / 2, y: p.y - r - l.h },
        { x: p.x + r, y: p.y - l.h / 2 },
        { x: p.x - r - l.w, y: p.y - l.h / 2 },
      ].map(({ x, y }) => ({ x1: x, y1: y, x2: x + l.w, y2: y + l.h }));
      const free = spots.find(isFree);
      const box = free ?? spots[0]!;
      l.el.style.transform = `translate(${Math.round(box.x1)}px, ${Math.round(box.y1)}px)`;
      const onScreen = box.x2 > 0 && box.x1 < width && box.y2 > 0 && box.y1 < height;
      const shown = !l.node.hasClass("lod-hidden") || l.node.hasClass("lit");
      // Names on a tapped topic's route always show, even if no spot is free.
      const visible = shown && onScreen && (!!free || l.node.hasClass("lit"));
      if (visible) placed.push(box);
      l.el.classList.toggle("off", !visible);
      l.el.classList.toggle("faded", visible && l.node.hasClass("faded"));
    }
  }

  // The more you zoom in, the more topics and links are drawn; at the closest zoom, their summaries too.
  function applyZoomLevel() {
    const r = cy.zoom() / fitZoom;
    cy.batch(() => {
      const hidden = topics.filter((n) => r < n.data("appearAt"));
      const shown = topics.difference(hidden);
      hidden.union(hidden.connectedEdges()).filter((e) => !e.hasClass("lod-hidden")).addClass("lod-hidden");
      shown.union(shown.edgesWith(shown)).filter(".lod-hidden").removeClass("lod-hidden");
    });
    layer.classList.toggle("far", r < PARTS_ONLY);
    if (layer.classList.contains("detail") !== r >= DETAIL) {
      layer.classList.toggle("detail", r >= DETAIL);
      measureLabels();
    }
  }

  fitAll();
  measureLabels();
  applyZoomLevel();
  placeLabels();
  cy.on("zoom", applyZoomLevel);
  cy.on("render", placeLabels);
  // Part titles grow or shrink with an animation when zooming past "far"; place them again at its end.
  layer.addEventListener("transitionend", placeLabels);
  addEventListener("resize", () => {
    const before = view();
    cy.resize();
    fitAll();
    setView(before);
  });

  // The view as zoom (relative to "show everything") and the map point at the center of the screen.
  type View = { zoom: number; x: number; y: number };
  function view(): View {
    const z = cy.zoom();
    const pan = cy.pan();
    return { zoom: z / fitZoom, x: (root.clientWidth / 2 - pan.x) / z, y: (root.clientHeight / 2 - pan.y) / z };
  }
  function setView(v: View) {
    const z = Math.min(cy.maxZoom(), Math.max(cy.minZoom(), fitZoom * v.zoom));
    cy.viewport({ zoom: z, pan: { x: root.clientWidth / 2 - v.x * z, y: root.clientHeight / 2 - v.y * z } });
  }

  // Smooth zoom: each wheel notch or button press moves a target zoom, and every frame the map
  // glides part of the way there, around the point under the cursor.
  let target = cy.zoom();
  let anchor = { x: 0, y: 0 };
  let frame = 0;
  function glide() {
    const now = cy.zoom();
    const done = Math.abs(Math.log(target / now)) < 0.002;
    cy.zoom({ level: done ? target : now * Math.pow(target / now, 0.22), renderedPosition: anchor });
    frame = done ? 0 : requestAnimationFrame(glide);
  }
  function zoomTowards(factor: number, at: { x: number; y: number }) {
    const from = frame ? target : cy.zoom();
    target = Math.min(cy.maxZoom(), Math.max(cy.minZoom(), from * factor));
    anchor = at;
    if (!frame) frame = requestAnimationFrame(glide);
  }
  function stopGlide() {
    cancelAnimationFrame(frame);
    frame = 0;
  }

  // Cytoscape zooms only about 3% per mouse-wheel notch, so handle the wheel here:
  // about 1.3× per notch (a trackpad pinch arrives as small wheel events with ctrlKey).
  root.parentElement!.addEventListener(
    "wheel",
    (e) => {
      if ((e.target as Element).closest("#map-panel")) return;
      e.preventDefault();
      e.stopPropagation();
      const delta = e.deltaY * (e.deltaMode === 1 ? 33 : 1) * (e.ctrlKey ? 4 : 1);
      const box = root.getBoundingClientRect();
      zoomTowards(Math.pow(2, -delta / 250), { x: e.clientX - box.left, y: e.clientY - box.top });
    },
    { capture: true, passive: false },
  );

  // Cytoscape does not pan when a drag starts on a topic, so pan by hand.
  let dragFrom: cytoscape.Position | null = null;
  cy.on("tapstart", "node:childless", (e) => (dragFrom = e.renderedPosition));
  cy.on("tapstart", stopGlide);
  cy.on("tapdrag", (e) => {
    if (!dragFrom) return;
    cy.panBy({ x: e.renderedPosition.x - dragFrom.x, y: e.renderedPosition.y - dragFrom.y });
    dragFrom = e.renderedPosition;
  });
  cy.on("tapend", () => (dragFrom = null));

  // Tapping a topic lights up what to learn first and what it unlocks.
  const panel = document.getElementById("map-panel")!;
  const $ = (id: string) => document.getElementById(id)!;
  const kind: Record<string, string> = { concept: "Topic", event: "History", project: "Project", hub: "Overview" };
  const statusText: Record<string, string> = {
    published: "", review: " · Being written", draft: " · Being written", planned: " · Not written yet",
  };
  const titles = (nodes: cytoscape.NodeCollection) => nodes.map((n) => n.data("title") as string).join(", ");

  function clearFocus() {
    cy.elements().removeClass("faded lit focus before after");
    panel.hidden = true;
    selected = null;
    saveView();
  }

  cy.on("tap", (e) => {
    if (e.target === cy) clearFocus();
  });
  cy.on("tap", "node:childless", (e) => selectTopic(e.target));
  function selectTopic(node: cytoscape.NodeSingular) {
    // Only the topics right before and right after: lighting up every step would light up most of the map.
    const needs = node.incomers();
    const unlocks = node.outgoers();
    cy.batch(() => {
      cy.elements().removeClass("lit focus before after").addClass("faded");
      const lit = node.union(needs).union(unlocks);
      lit.union(lit.nodes().parents()).removeClass("faded").addClass("lit");
      needs.edges().addClass("before");
      unlocks.edges().addClass("after");
      node.addClass("focus");
    });

    const d = node.data() as MapNode;
    const direct = { needs: needs.nodes(), unlocks: unlocks.nodes() };
    $("panel-kind").textContent = `${kind[d.type] ?? d.type}${d.year ? ` · ${d.year}` : ""}${statusText[d.status] ?? ""}`;
    $("panel-title").textContent = d.title;
    $("panel-summary").textContent = d.summary;
    $("panel-requires").textContent = direct.needs.length
      ? `Learn first: ${titles(direct.needs)}`
      : "Nothing to learn first: you can start here.";
    $("panel-leads").textContent = direct.unlocks.length ? `Unlocks: ${titles(direct.unlocks)}` : "";
    $("panel-leads-row").hidden = !direct.unlocks.length;
    const read = $("panel-read") as HTMLAnchorElement;
    read.href = d.url;
    read.hidden = !d.readable;
    panel.hidden = false;
    selected = d.id;
    saveView();
  }
  panel.querySelector(".close")!.addEventListener("click", clearFocus);
  addEventListener("keydown", (e) => e.key === "Escape" && clearFocus());

  document.querySelectorAll<HTMLButtonElement>(".map-controls button").forEach((b) =>
    b.addEventListener("click", () => {
      if (b.dataset.zoom === "fit") {
        stopGlide();
        return void cy.animate({ fit: { eles: cy.elements(), padding: 40 } }, { duration: 400, easing: "ease-in-out-cubic" });
      }
      zoomTowards(b.dataset.zoom === "in" ? 2 : 1 / 2, { x: root.clientWidth / 2, y: root.clientHeight / 2 });
    }),
  );

  // Remember the view and the tapped topic in the address (like a street map), so pressing Back
  // after "Read", reloading or sharing the link returns to the same place.
  let selected: string | null = null;
  let saveTimer = 0;
  function saveView() {
    clearTimeout(saveTimer);
    saveTimer = window.setTimeout(() => {
      const v = view();
      const q = new URLSearchParams();
      if (selected) q.set("topic", selected);
      q.set("zoom", v.zoom.toFixed(3));
      q.set("x", String(Math.round(v.x)));
      q.set("y", String(Math.round(v.y)));
      history.replaceState(history.state, "", `?${q}`);
    }, 250);
  }
  cy.on("viewport", saveView);

  // Open where the address says: a saved view, or a topic (from "See on the map" on a topic page).
  const q = new URLSearchParams(location.search);
  const start = q.get("topic") ? cy.getElementById(q.get("topic")!).filter(":childless") : cy.collection();
  const saved = ["zoom", "x", "y"].map((k) => Number(q.get(k)));
  if (q.has("zoom") && saved.every(Number.isFinite)) setView({ zoom: saved[0]!, x: saved[1]!, y: saved[2]! });
  else if (start.nonempty()) setView({ zoom: 2, ...start.position() });
  if (start.nonempty()) selectTopic(start as cytoscape.NodeSingular);
</script>
