---
import Base from "../layouts/Base.astro";
import { isReadable, nodes, nodeUrl } from "../lib/content.ts";

const events = nodes.filter((n) => n.type === "event" && n.year !== undefined).sort((a, b) => a.year! - b.year!);
---

<Base title="Timeline" description="How we got from the abacus to the smartphone: the machines, networks and people of computing history in date order, each with its own page.">
  <div class="narrow">
    <h1>Timeline</h1>
    <p class="muted">How we got from counting on an abacus to a computer in your pocket.</p>
    <ol class="timeline">
      {
        events.map((e) => (
          <li data-node={isReadable(e) ? e.id : undefined}>
            <span class="when">{e.era_label ?? e.year}</span>
            <a href={nodeUrl(e.id)}>{e.title}</a>
            {e.summary && <div class="small muted">{e.summary}</div>}
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<script>
  import { loadProgress, markReadTopics } from "../scripts/account.ts";

  // Signed-in readers: a ✓ on each event they have marked as read.
  loadProgress().then((progress) => progress && markReadTopics(progress));
</script>
