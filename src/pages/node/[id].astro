---
import MiniMap from "../../components/MiniMap.astro";
import Base from "../../layouts/Base.astro";
import { byIds, isReadable, leadsTo, nodeUrl, nodes, pathPosition, renderBody, sectionsOf, type Node } from "../../lib/content.ts";

export function getStaticPaths() {
  return nodes.map((node) => ({ params: { id: node.id }, props: { node } }));
}

const { node } = Astro.props as { node: Node };
const readable = isReadable(node);
const html = readable ? await renderBody(node) : "";
const sections = readable ? sectionsOf(node) : [];
const position = pathPosition(node.id);
const learnFirst = byIds(node.requires);
const next = leadsTo(node.id);
// A topic already under "Learn first" or "Leads to" is not listed again under "Related".
const listed = new Set([...learnFirst, ...next].map((n) => n.id));
const related = byIds([...new Set([...node.related, ...node.part_of, ...node.led_to])]).filter((n) => !listed.has(n.id));
// Opens a GitHub issue form with this topic already filled in.
const reportUrl = `https://github.com/adityaokke/programmersbible/issues/new?${new URLSearchParams({
  template: "report-a-problem.yml",
  title: `Problem in "${node.title}"`,
  topic: node.id,
})}`;
// "ai" means the ai-reviewer agent approved it; say plainly that no human has checked it yet.
const reviewed = !node.reviewed_by
  ? undefined
  : node.reviewed_by === "ai"
    ? "Reviewed by AI · Not yet checked by a human"
    : `Reviewed by ${node.reviewed_by}`;
const byline =
  node.author === "ai"
    ? `Written with AI · ${reviewed ?? "Not reviewed yet"}`
    : node.author
      ? `Written by ${node.author}${reviewed ? ` · ${reviewed}` : ""}`
      : undefined;
---

<Base title={node.title} description={node.summary} noindex={node.status !== "published"}>
  {
    position && (
      <div class="breadcrumb">
        <a href={`/path/${position.path.id}`}>{position.path.title}</a> › {position.section.title} › {position.index + 1} of{" "}
        {position.total}
      </div>
    )
  }

  <div class="node-layout">
    {/* "On this page" is in one of three places, by screen width (see global.css): this left column
        on wide screens, the top of the sidebar on medium ones, a box under the title on phones. */}
    {
      sections.length > 1 && (
        <nav class="toc toc-side toc-left" aria-label="On this page">
          <h2>On this page</h2>
          <ul>
            {sections.map((s) => (
              <li>
                <a href={`#${s.id}`}>{s.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    {/* Search (Pagefind) indexes only published topics: their text, plus the other names and the
        questions each one answers, which count a little more. */}
    <article
      data-pagefind-body={readable ? "" : undefined}
      data-pagefind-ignore={readable ? undefined : "all"}
      data-topic={readable ? node.id : undefined}
    >
      <h1>{node.title}</h1>
      {
        readable && (
          <div hidden>
            <span data-pagefind-meta="summary">{node.summary}</span>
            <p data-pagefind-weight="3">{[...node.aliases, ...node.questions].join(". ")}</p>
          </div>
        )
      }
      <p class="small muted">
        {node.type === "event" && <span class="event-mark">🕰 {node.era_label ?? node.year} · </span>}
        {node.read_minutes && <>⏱ {node.read_minutes} min read</>}
        {readable && node.status !== "published" && (
          <>
            {" "}
            <span class={`badge ${node.status}`}>{node.status}</span>
          </>
        )}
      </p>

      <MiniMap node={node} learnFirst={learnFirst} next={next} />

      {
        sections.length > 1 && (
          <details class="toc toc-top">
            <summary>On this page</summary>
            <ul>
              {sections.map((s) => (
                <li>
                  <a href={`#${s.id}`}>{s.title}</a>
                </li>
              ))}
            </ul>
          </details>
        )
      }

      {
        readable ? (
          <Fragment set:html={html} />
        ) : (
          <div class="notice">
            <p>
              <strong>This topic is not ready yet.</strong> It will be published after it has been fact-checked and
              reviewed.
            </p>
            {learnFirst.length > 0 && <p>While you wait, you can read what comes before it (shown above).</p>}
          </div>
        )
      }

      {readable && byline && <p class="small muted">{byline}</p>}
      {
        readable && (
          <p class="small muted">
            Found a mistake, or something you did not understand? <a href={reportUrl}>Report a problem</a>.
          </p>
        )
      }

      {
        position && (
          <nav class="pager" aria-label="Previous and next topic">
            <span>{position.prev && <a href={nodeUrl(position.prev.id)}>← {position.prev.title}</a>}</span>
            <span>{position.next && <a href={nodeUrl(position.next.id)}>{position.next.title} →</a>}</span>
          </nav>
        )
      }
    </article>

    <aside class="sidebar" aria-label="Related topics">
      {
        sections.length > 1 && (
          <nav class="toc toc-side" aria-label="On this page">
            <h2>On this page</h2>
            <ul>
              {sections.map((s) => (
                <li>
                  <a href={`#${s.id}`}>{s.title}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      {
        related.length > 0 && (
          <section class="links related">
            <h2>Related</h2>
            <ul>
              {related.map((n) => (
                <li>
                  <a href={nodeUrl(n.id)}>{n.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </aside>
  </div>
</Base>

<script>
  import { loadProgress, saveProgress, type Progress } from "../../scripts/account.ts";

  // A Copy button on each code block. Without scripts the code still reads the same, with no button.
  for (const block of document.querySelectorAll<HTMLElement>(".code-block")) {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "copy-code";
    button.textContent = "Copy";
    button.setAttribute("aria-label", `Copy this ${block.querySelector("figcaption")!.textContent} code`);
    let reset = 0;
    button.addEventListener("click", async () => {
      clearTimeout(reset);
      try {
        await navigator.clipboard.writeText(block.querySelector("code")!.textContent!);
        button.textContent = "Copied";
      } catch {
        button.textContent = "Could not copy";
      }
      reset = window.setTimeout(() => (button.textContent = "Copy"), 2000);
    });
    block.querySelector("figcaption")!.append(button);
  }

  // Tabs for the same idea in several languages. The script makes them: without it, each panel
  // shows under its own heading. A closed panel can still be found with the browser's search.
  const tabGroups: { show: (label: string) => void }[] = [];
  // Choosing a language switches every group on this page. Nothing is stored: see the privacy page.
  const choose = (label: string) => tabGroups.forEach((g) => g.show(label));
  document.querySelectorAll<HTMLElement>(".code-tabs").forEach((group, g) => {
    const panels = [...group.querySelectorAll<HTMLElement>(":scope > .tab-panel")];
    const list = document.createElement("div");
    list.className = "tab-list";
    list.setAttribute("role", "tablist");
    list.setAttribute("aria-label", "Choose a language");
    const tabs = panels.map((panel, i) => {
      const heading = panel.querySelector("h3")!;
      const tab = document.createElement("button");
      tab.type = "button";
      tab.id = `tab-${g}-${i}`;
      tab.textContent = heading.textContent;
      tab.setAttribute("role", "tab");
      tab.setAttribute("aria-controls", (panel.id = `panel-${g}-${i}`));
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", tab.id);
      heading.hidden = true;
      tab.addEventListener("click", () => choose(tab.textContent ?? ""));
      panel.addEventListener("beforematch", () => show(i));
      return tab;
    });
    function show(chosen: number) {
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === chosen));
        tab.tabIndex = panels[i]!.tabIndex = i === chosen ? 0 : -1; // a closed panel takes no keyboard focus
        if (i === chosen) panels[i]!.removeAttribute("hidden");
        else panels[i]!.setAttribute("hidden", "until-found");
      });
    }
    // Arrow keys move between tabs; Tab moves on to the open panel.
    list.addEventListener("keydown", (e) => {
      const now = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true");
      const next = ({ ArrowRight: now + 1, ArrowLeft: now - 1 + tabs.length, Home: 0, End: tabs.length - 1 } as Record<string, number>)[e.key];
      if (next === undefined) return;
      e.preventDefault();
      choose(tabs[next % tabs.length]!.textContent ?? "");
      tabs[next % tabs.length]!.focus();
    });
    list.append(...tabs);
    group.prepend(list);
    show(0);
    tabGroups.push({
      show(label) {
        const i = tabs.findIndex((t) => t.textContent === label);
        if (i >= 0) show(i);
      },
    });
  });

  // Mark the section being read in "On this page": the last heading that has scrolled past the top third.
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc-side a")];
  const headings = [...new Set(links.map((a) => a.hash.slice(1)))]
    .map((id) => document.getElementById(id))
    .filter((h) => h !== null);
  function mark() {
    const line = innerHeight / 3;
    let current = headings[0]!;
    for (const h of headings) if (h.getBoundingClientRect().top < line) current = h;
    for (const a of links) {
      if (a.hash === `#${current.id}`) a.setAttribute("aria-current", "true");
      else a.removeAttribute("aria-current");
    }
  }
  if (headings.length) {
    addEventListener("scroll", mark, { passive: true });
    mark();
  }

  // ---- Signed-in readers only: progress. Signed out (or if the API fails), none of this appears. ----

  const article = document.querySelector<HTMLElement>("article[data-topic]");
  if (article) {
    const topic = article.dataset.topic!;
    loadProgress().then((progress) => {
      if (!progress) return;
      saveProgress(topic, {}); // a visit: this becomes the "Continue reading" topic on the home page
      addReadToggle(topic, progress, article);
      followSections(topic, progress, article);
    });
  }

  // "Mark as read": a toggle button near the end of the topic.
  function addReadToggle(topic: string, progress: Progress, article: HTMLElement) {
    let read = progress.nodes[topic]?.status === "read";
    const box = document.createElement("div");
    box.className = "reading-progress";
    const button = document.createElement("button");
    button.type = "button";
    button.className = "toggle-read";
    button.innerHTML = '<span class="check" aria-hidden="true"></span>Mark as read';
    const note = document.createElement("span");
    note.className = "small muted";
    note.setAttribute("role", "status");
    const show = () => {
      button.setAttribute("aria-pressed", String(read));
      button.querySelector(".check")!.textContent = read ? "✓" : "";
    };
    button.addEventListener("click", async () => {
      button.disabled = true;
      const ok = await saveProgress(topic, { status: read ? "visited" : "read" });
      button.disabled = false;
      if (ok) read = !read;
      show();
      note.textContent = !ok
        ? "Could not save. Please try again."
        : read
          ? "Marked as read. You will see a ✓ next to it in the lists."
          : "No longer marked as read.";
    });
    show();
    box.append(button, note);
    const pager = article.querySelector(".pager");
    if (pager) pager.before(box);
    else article.append(box);
  }

  // Remember the last section the reader reached, and offer to go back there. Never scrolls by itself.
  function followSections(topic: string, progress: Progress, article: HTMLElement) {
    const sections = [...article.querySelectorAll<HTMLElement>("h2[id]")];
    if (!sections.length) return;
    // The section being read: the last heading that has scrolled past the top third of the window.
    const current = () => {
      let found: HTMLElement | null = null;
      for (const h of sections) if (h.getBoundingClientRect().top < innerHeight / 3) found = h;
      return found;
    };

    const saved = progress.nodes[topic]?.lastHeading;
    const target = saved ? sections.find((h) => h.id === saved) : undefined;
    let pill: HTMLElement | null = null;
    // Offer it only when the reader is above that section and did not open a link to a section.
    if (target && !location.hash && target.getBoundingClientRect().top > innerHeight / 3) {
      pill = document.createElement("div");
      pill.className = "resume";
      const go = document.createElement("button");
      go.type = "button";
      go.className = "go";
      go.textContent = `Continue from “${target.textContent?.trim()}”`;
      const close = document.createElement("button");
      close.type = "button";
      close.className = "close";
      close.setAttribute("aria-label", "Hide this");
      close.textContent = "×";
      go.addEventListener("click", () => {
        const smooth = !matchMedia("(prefers-reduced-motion: reduce)").matches;
        target.scrollIntoView({ behavior: smooth ? "smooth" : "auto" });
        target.tabIndex = -1;
        target.focus({ preventScroll: true });
        hidePill();
      });
      close.addEventListener("click", hidePill);
      pill.append(go, close);
      document.body.append(pill);
    }
    function hidePill() {
      pill?.remove();
      pill = null;
    }

    // Save at most every 5 seconds, and when the page is closed or hidden.
    const start = current()?.id ?? null;
    let lastSaved = saved ?? null;
    let pending: string | null = null;
    let timer = 0;
    const flush = (closing = false) => {
      clearTimeout(timer);
      timer = 0;
      if (!pending || pending === lastSaved) return;
      lastSaved = pending;
      saveProgress(topic, { lastHeading: pending }, closing);
      pending = null;
    };
    const check = () => {
      const h = current();
      // Where the page opened is not "reached" yet: wait until the reader moves to another section.
      if (!h || h.id === start) return;
      if (target && sections.indexOf(h) >= sections.indexOf(target)) hidePill();
      pending = h.id;
      if (!timer) timer = window.setTimeout(flush, 5000);
    };
    const observer = new IntersectionObserver(check, { rootMargin: "0px 0px -66% 0px" });
    sections.forEach((h) => observer.observe(h));
    addEventListener("pagehide", () => flush(true));
    document.addEventListener("visibilitychange", () => document.visibilityState === "hidden" && flush(true));
  }
</script>
