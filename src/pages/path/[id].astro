---
import Base from "../../layouts/Base.astro";
import PathTopic from "../../components/PathTopic.astro";
import { allPaths, pathNumbers } from "../../lib/content.ts";
import type { PathFile } from "../../../schema/node.ts";

export function getStaticPaths() {
  return allPaths.map((path) => ({ params: { id: path.id }, props: { path } }));
}

const { path } = Astro.props as { path: PathFile };
// In-order topics are numbered through the whole path. Topics of "any order" and "choose one" parts
// get a dot instead: their order does not matter.
const numbers = pathNumbers(path);
---

<Base title={path.title} description={path.description}>
  <div class="narrow">
    <p class="small muted" style="margin-bottom: -1rem"><a href="/paths">Learning paths</a> ›</p>
    <h1 id="path-title">{path.title}</h1>
    {path.description && <p class="muted">{path.description}</p>}

    {
      path.sections.map((section) => (
        <section class="path-section">
          <h2>{section.title}</h2>
          {"choose_one" in section ? (
            <>
              <p class="muted">Choose one to read next. You can come back for the others at any time.</p>
              <div class="choices">
                {section.choose_one.map((choice) => (
                  <div class="choice">
                    <h3>{choice.title}</h3>
                    <ul class="node-list">{choice.nodes.map((id) => <PathTopic id={id} pathId={path.id} />)}</ul>
                  </div>
                ))}
              </div>
            </>
          ) : (
            <>
              {section.any_order && <p class="muted">Read these in any order: they do not depend on each other.</p>}
              {section.any_order ? (
                <ul class="node-list">{section.nodes.map((id) => <PathTopic id={id} pathId={path.id} />)}</ul>
              ) : (
                <ol class="node-list">{section.nodes.map((id) => <PathTopic id={id} pathId={path.id} number={numbers.get(id)} />)}</ol>
              )}
            </>
          )}
        </section>
      ))
    }
  </div>
</Base>

<style>
  /* The choices of a "choose one" part side by side; one above the other on a phone. */
  .choices { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1rem; }
  .choice { padding: 0.25rem 1rem 0.75rem; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
  .choice h3 { margin: 0.5rem 0; font-size: 1.05rem; }
  .choice :global(.node-list li:last-child) { border-bottom: 0; }
</style>

<script>
  import { loadProgress, markReadTopics, type Progress } from "../../scripts/account.ts";

  // Signed-in readers: a ✓ beside each topic they have marked as read, and how many of each part's
  // topics they have read. Signed out, nothing is added.
  loadProgress().then((progress) => {
    if (!progress) return;
    markReadTopics(progress);
    showReadCounts(progress);
  });

  // "12 of 31 read" after each part's heading and the path's title. Only topics that can be read
  // count: the ones that get a ✓ (data-node), not the ones "not ready yet".
  function showReadCounts(progress: Progress) {
    const count = (root: ParentNode) => {
      const topics = [...new Set([...root.querySelectorAll<HTMLElement>("[data-node]")].map((el) => el.dataset.node!))];
      return { all: topics.length, read: topics.filter((id) => progress.nodes[id]?.status === "read").length };
    };
    const add = (heading: Element | null, { all, read }: { all: number; read: number }) => {
      if (!heading || !all) return;
      const note = document.createElement("span");
      note.className = "read-count muted";
      note.textContent = `· ${read} of ${all} read`;
      heading.append(" ", note);
    };
    for (const section of document.querySelectorAll(".path-section")) add(section.querySelector("h2"), count(section));
    add(document.getElementById("path-title"), count(document));
  }
</script>
