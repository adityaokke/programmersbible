---
import Base from "../layouts/Base.astro";
---

<Base title="Sign in" description="Sign in with Google to mark topics as read and pick up where you left off, on any device." noindex>
  <div class="narrow">
    <h1>Sign in</h1>
    <p id="signin-error" class="notice" role="alert" hidden>
      Signing in did not work. Please try again. If it keeps failing, <a href="https://github.com/adityaokke/programmersbible/issues">tell us on GitHub</a>.
    </p>
    <p id="signin-done" class="notice" hidden>
      You are signed in. <a href="/me">See your account and reading progress</a>.
    </p>

    <p>
      You can read everything on this site without an account. Signing in adds a few things that help you keep going:
    </p>
    <ul>
      <li><strong>Mark as read:</strong> a button at the end of each topic. Read topics get a ✓ in the lists.</li>
      <li><strong>Continue where you left off:</strong> when you come back to a topic, a button takes you to the last part you reached.</li>
      <li><strong>The same progress on every device</strong> where you sign in.</li>
    </ul>

    <p>
      <button type="button" class="button google" id="google">Sign in with Google</button>
    </p>
    <noscript><p class="small muted">Signing in needs JavaScript, which is turned off in this browser. Reading does not.</p></noscript>
    <p id="google-status" class="small muted" role="status"></p>

    <h2>What the site keeps</h2>
    <p>
      Your name, email address and profile picture from your Google account, and which topics you have opened or
      marked as read. Nothing else, and you can download it or delete your account at any time. The
      <a href="/privacy">privacy page</a> has the details.
    </p>
  </div>
</Base>

<style>
  .google { border: 0; font: inherit; font-weight: 600; cursor: pointer; }
  .google:disabled { opacity: 0.7; cursor: progress; }
</style>

<script>
  import { loadProgress, safeReturnPath, signInWithGoogle } from "../scripts/account.ts";

  const query = new URLSearchParams(location.search);
  const returnTo = safeReturnPath(query.get("return"));
  if (query.has("error")) document.getElementById("signin-error")!.hidden = false;
  loadProgress().then((progress) => {
    if (progress) document.getElementById("signin-done")!.hidden = false;
  });

  const button = document.getElementById("google") as HTMLButtonElement;
  const status = document.getElementById("google-status")!;
  button.addEventListener("click", async () => {
    button.disabled = true;
    status.textContent = "Taking you to Google…";
    if (!(await signInWithGoogle(returnTo))) {
      button.disabled = false;
      status.textContent = "Could not reach the sign-in service. Please try again in a moment.";
    }
  });
  // Coming back with the Back button from Google's page: the button works again.
  addEventListener("pageshow", () => {
    button.disabled = false;
    status.textContent = "";
  });
</script>
