---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = "From knowing how to use a browser to understanding how it all works." } = Astro.props;
const fullTitle = title ? `${title} · Programmer's Bible` : "Programmer's Bible";
const REPO = "https://github.com/adityaokke/programmersbible";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">📖 Programmer's Bible</a>
      <nav>
        <a href="/path/first-chapter">First Chapter</a>
        <a href="/map">Map</a>
        <a href="/timeline">Timeline</a>
      </nav>
      <form action="/search" method="get" role="search">
        <input type="search" name="q" placeholder="Search a topic…" aria-label="Search" />
      </form>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Free and open source. Text and pictures written for this site:{" "}
        <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license">CC BY-SA 4.0</a>. Code:{" "}
        <a href={`${REPO}/blob/main/LICENSE`}>MIT</a>. Photos keep their own licenses, credited under each one.
      </p>
      <p>
        Topics are written with AI and checked against the sources listed at the end of each one. Each topic says who
        reviewed it. <a href={`${REPO}/issues/new?template=report-a-problem.yml`}>Report a problem</a> ·{" "}
        <a href={REPO}>Source on GitHub</a>
      </p>
    </footer>
  </body>
</html>
